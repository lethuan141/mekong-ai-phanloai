# Dịch vụ dự đoán
MODEL_PORT=8080
MODEL_PATH=artifacts/model_v1.joblib

# Ngưỡng tin cậy: dưới ngưỡng này thì trả về cờ can_nguoi_xem_lai = true
# và KHÔNG đưa ra nhãn gợi ý. Xem docs/model-card.md mục 9.
NGUONG_TIN_CAY=0.45

# Ngưỡng riêng cho mô tả NGẮN (dưới 10 từ) — cao hơn, vì mô hình hoạt động
# kém hẳn với mô tả ngắn. Đây là biện pháp giảm thiểu thiên lệch đã đo.
NGUONG_TIN_CAY_MO_TA_NGAN=0.60

LOG_LEVEL=INFO
